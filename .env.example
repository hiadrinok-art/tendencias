# Copie para .env e preencha. Nunca faça commit do .env.
# Gere com: python -c 'import secrets; print(secrets.token_urlsafe(48))'
RADAR_SEGREDO=
RADAR_BANCO=radar.db
RADAR_ORIGENS=http://localhost:3000
# 1 em produção (cookies Secure + HSTS); 0 só para testar localmente sem HTTPS
RADAR_HTTPS=1
# IPs do proxy/balanceador na frente da API, separados por vírgula (vazio se não houver)
RADAR_PROXIES=
