    {"id": 7, "fala": "Seus líderes foram presos, e vários, executados.", "gatilho": "presos", "t": 25.98, "acao": "cair", "alvo": "sentenca1817", "som": "papel"},
    {"id": 8, "fala": "Pouco depois, a Coroa desmembrou de Pernambuco a comarca das Alagoas.", "gatilho": "Alagoas", "t": 33.12, "acao": "mover", "alvo": "alagoas", "foco": "mapa-pe", "para": {"x": 160, "y": 240, "rotation": 7}, "duracao": 1.4},
    {"id": 9, "fala": "Sete anos mais tarde, Pernambuco se levanta de novo. Em 1824,", "gatilho": "1824", "t": 39.04, "acao": "datilografar", "alvo": "data1824", "som": "maquina"},
    {"id": 10, "fala": "contra um imperador que havia fechado a Assembleia Constituinte,", "gatilho": "fechado", "t": 43.00, "acao": "carimbar", "alvo": "carimbo-dissolvida", "som": "carimbo"},
    {"id": 11, "fala": "nasce a Confederação do Equador.", "gatilho": "Confederação", "t": 46.60, "acao": "datilografar", "alvo": "confed", "som": "maquina"},
    {"id": 12, "fala": "A voz mais forte do movimento", "gatilho": "voz", "t": 48.90, "acao": "cair", "alvo": "typhis", "som": "papel"},
    {"id": 13, "fala": "é a de um frade: Frei Caneca.", "gatilho": "Frei", "t": 52.28, "acao": "cair", "alvo": "retrato-caneca", "som": "papel"},
    {"id": 14, "fala": "Condenado à forca,", "gatilho": "forca", "t": 54.64, "acao": "circular", "alvo": "sentenca-forca", "circulo": "circ-forca", "foco": "sentenca-forca", "som": "pena"},
    {"id": 15, "fala": "Em 13 de janeiro de 1825, Frei Caneca foi fuzilado.", "gatilho": "13", "t": 59.90, "acao": "datilografar", "alvo": "data1825", "som": "maquina"},
    {"id": 16, "fala": "Quase um século depois, em 1917, a bandeira de 1817", "gatilho": "1917", "t": 68.30, "acao": "reacender", "alvo": "bandeira1817"},
